{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "cbc:verify": "node ./scripts/ingest-private-cbc.mjs --verify",
    "cbc:ingest": "node ./scripts/ingest-private-cbc.mjs",
    "cbc:check": "node ./scripts/check-private-cbc.mjs",
    "cbc:validate": "node ./scripts/validate-cbc-kb.mjs"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@google-cloud/text-to-speech": "^7.0.0",
    "@octokit/rest": "^22.0.1",
    "@simplewebauthn/server": "^13.3.2",
    "adm-zip": "^0.6.0",
    "cors": "^2.8.6",
    "docx": "^9.6.1",
    "exceljs": "^4.4.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.3.2",
    "google-auth-library": "^11.0.0",
    "mammoth": "^1.8.0",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.4.1"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "ts-deepmerge": "^8.0.0",
    "websocket-driver": "^0.7.5"
  },
  "private": true
}
