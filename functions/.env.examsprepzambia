# Monthly app-side AI spend ceiling (USD). A runaway guard, not a tight
# budget: when month-to-date tracked spend reaches this, callAnthropic /
# callAnthropicStream / callOpenAI / callOpenAIStream refuse new calls until
# the next UTC month (see aiCostTracking.getBudgetStatus). aiCostDailySummary
# emails the admin list at 80% (warning) and 100% (paused). Set comfortably
# above normal monthly spend — hitting it pauses ALL app-side AI.
# Scope note: this only covers the deployed app's own calls. Claude Code /
# managed-agent (Opus) usage on the same API key is governed by the Anthropic
# console org spend limit, not this ceiling.
AI_MONTHLY_BUDGET_USD=100

# ── Self-funding governor (treasury) ───────────────────────────────────────
# Switches the AI spend ceiling from the fixed AI_MONTHLY_BUDGET_USD above to a
# REVENUE-LINKED one: ceiling = monthRevenueUsd × AI_REVENUE_REINVEST_RATIO,
# with AI_BUDGET_FLOOR_USD as a floor. monthRevenueUsd = this month's confirmed
# `payments` (ZMW) ÷ AI_TREASURY_ZMW_PER_USD. Read in
# aiCostTracking.getBudgetStatus (see functions/treasury.js and
# ORG.md → Treasury & Self-Funding). Visible live at /admin/company.
#
# BOOTSTRAP FLOOR — set to $25 while the platform is pre-revenue. The
# effective ceiling is max($25, revenue × 30%):
#   - At today's spend (~$3/mo) the $25 floor leaves ~8× headroom, so this
#     can't pause AI; it's a tighter runaway guard than the old flat $100.
#   - The cap is monotonic (only ever rises with revenue), so there is no
#     cliff — a first small sale can't suddenly crater the budget.
#   - It auto-converts to TRUE self-funding once revenue × 30% overtakes $25
#     (≈ K2,160/mo earned), after which the cap grows with earnings.
# Lower it further (toward $0) only once /admin/company shows revenue × 30%
# comfortably above monthly spend, or a first sale could pause AI. The static
# AI_MONTHLY_BUDGET_USD above still acts as the fallback if revenue reads as $0.
AI_BUDGET_MODE=revenue_linked
AI_REVENUE_REINVEST_RATIO=0.30
AI_TREASURY_ZMW_PER_USD=26
AI_BUDGET_FLOOR_USD=25

# ── App Check enforcement (staged rollout — canary armed 2026-07-08) ─────────
# App Check runs in SOFT-VERIFY (observe-only) by default: every AI endpoint
# checks the caller's attestation token and counts it in appCheckHealth/{date},
# but nothing is blocked. Enforcing hard-denies calls with a missing/invalid
# token. Web reCAPTCHA Enterprise attestation was fixed 2026-07-08; the
# /admin/app-check dashboard is the source of truth for when it's safe to widen.
# See functions/appCheckEnforcement.js (resolver) + functions/index.js (labels).
#
# CANARY (ACTIVE ON DEPLOY): the two endpoints /admin/app-check showed at 100%
# valid. ⚠️ MERGE GATE — before merging this, confirm on /admin/app-check:
#   • total calls ≥ 200 (the dashboard clears its own "HOLD" banner), AND
#   • aiChat + generateQuizQuestions still read ~100% valid — i.e. 0 unattested
#     from real clients, so stale pre-fix browser bundles have cycled out.
# If either endpoint isn't clean yet, trim the list to the one that is (or hold
# the merge). Widen later by appending more labels as they go green. Enforcement
# is reversible: blank the value + redeploy to fall back to observe-only.
APPCHECK_ENFORCE_LABELS="aiChat,generateQuizQuestions"
#
# Global — enforce EVERY endpoint at once. Do NOT set this until Android Play
# Integrity is registered (docs/B3-PLAY-INTEGRITY-SETUP.md) and users are on a
# build with the App Check bridge, or every Android call will 401:
# APPCHECK_ENFORCE=1
