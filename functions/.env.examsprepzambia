FIRESTORE_BACKUP_BUCKET=gs://zedexams-backups

# ── Storage disaster-recovery mirror (DR-003) ───────────────────────────────
# The Firestore export above covers Firestore ONLY. Generated images, uploads,
# exports and past papers live in gs://examsprepzambia.firebasestorage.app and
# have no second copy — a delete is unrecoverable. The cross-region mirror is a
# Storage Transfer Service job (managed, scheduled) that `storageBackupCheck`
# (functions/storageBackup.js, 04:00 Africa/Lusaka) only VERIFIES; it does not
# create it. While this stays unset on a production runtime the check records
# opsStorageBackups/{date}.status="misconfigured" and emails an ERROR ops alert
# EVERY MORNING — which is correct, and is the alert to fix rather than mute.
#
# Turn it on:
#   1. npm run provision:storage-backup             # dry run — prints the plan
#   2. npm run provision:storage-backup -- --live   # creates bucket + STS job
#   3. uncomment the line below, open a PR, merge (deploy-firebase.yml ships it)
#   4. after the next 04:00 Lusaka run, opsStorageBackups/{today}.status must
#      read "fresh" ("empty" until the first transfer completes)
# See docs/production-readiness/14-backup-and-disaster-recovery.md §D.
#
# Leave this UNSET until the bucket exists: pointing the check at a bucket that
# isn't there swaps one true alert ("no backup") for a misleading one
# ("mirror health UNKNOWN").
STORAGE_BACKUP_BUCKET=gs://zedexams-storage-backup
#
# Optional. STORAGE_BACKUP_PREFIX narrows the freshness scan on a very large
# bucket (GCS lists by NAME, not by time, so a scan that can't reach the end of
# the bucket reports "health unknown" rather than a false "stale").
# STORAGE_BACKUP_MAX_AGE_HOURS is the staleness threshold; default 26.
# STORAGE_BACKUP_PREFIX=
# STORAGE_BACKUP_MAX_AGE_HOURS=26

# ── Ops-alert chat channel (OBS-004 second channel) ─────────────────────────
# sendOpsAlert (functions/opsAlert.js) posts every ops alert to a Slack-style
# incoming webhook AS WELL AS emailing ADMIN_EMAILS — two independent channels,
# so a broken mailbox can no longer swallow a critical alert. Alerts that flow
# here: agent circuit-breaker trips, Lenco amount-mismatch / over-collection /
# webhook errors, Google Play verification config errors, backup + storage-backup
# + rate-limiter canaries, and the cross-subsystem heartbeat dead-man's-switch.
#
# The URL itself is a CREDENTIAL (anyone holding it can post into the channel) so
# it is a Firebase secret — `firebase functions:secrets:set OPS_ALERT_WEBHOOK_URL`
# — and NOTHING about the chat channel is configured from this file.
#
# There was an OPS_ALERT_WEBHOOK_BOUND=1 flag here, meant to say "the secret
# exists, bind it". It could never work and it failed SILENTLY: `firebase deploy`
# decides which secrets to bind by analysing the source in a subprocess that gets
# only FIREBASE_CONFIG + GCLOUD_PROJECT (firebase-tools prepare.js →
# discoverBuild), while THIS file is loaded on a separate path that populates the
# deployed runtime's env. So the flag read as unset during analysis, no function
# bound the secret, the deploy passed (an unreferenced secret is never validated),
# and alerts went out by email only. The binding now lives in code —
# functions/opsAlertSecrets.js — where deploy analysis can see it. Do not
# reintroduce a deploy-behaviour flag here; its test forbids the process.env read.

# ── Ops-alert recipients ────────────────────────────────────────────────────
# Comma-separated. Resolved by functions/opsAlertRecipients.js and read by
# opsAlert.js, agents/cron.js, aiCostDailySummary.js and agents/runners/
# monitor.js. This DOES belong in this file, and the distinction from the note
# directly above is the point: that flag tried to change what `firebase deploy`
# BINDS, decided by source analysis that never loads this file. OPS_ALERT_EMAILS
# is read at RUNTIME from the deployed function's env — the path this file
# actually populates. It is config, not a credential: an address, with SMTP
# delivery authenticating separately via EMAIL_SMTP_USER / EMAIL_SMTP_PASSWORD.
#
# Until now there was no recipient list at all, so every alert fell back to the
# SMTP sender account or was dropped outright ("SMTP or OPS_ALERT_EMAILS not
# configured" — agents/runners/monitor.js). What now has a named recipient:
# agent circuit-breaker trips, Vigil's hourly failure report, the AI-cost daily
# summary + 80%/100% budget warnings, Firestore/Storage backup canaries, the
# rate-limiter + heartbeat dead-man's-switches, Lenco amount-mismatch and
# Google Play verification config errors.
OPS_ALERT_EMAILS=mahengamwelwa@gmail.com

# ── Admin bootstrap allowlist — DELIBERATELY UNSET ──────────────────────────
# ADMIN_EMAILS is NOT a mailing list. resolveInitialUserRole (functions/
# index.js) gives any account CREATED with an address listed here the `admin`
# role and claim at onCreate, and setUserRole mints those claims from the email
# string. Populating it therefore says "whoever can register this address may
# hold admin" — which is why alert delivery was moved to OPS_ALERT_EMAILS
# above; a notification address must never have to be an authorization grant.
#
# It is still honoured as a fallback recipient list (reading a list grants
# nothing), so an older deployment that set it keeps receiving alerts.
#
# Before setting it, know that an address here with NO existing Firebase Auth
# account is registerable by anyone: signup mints the admin claim, and
# bootstrapUserProfile — exempt from the email-verification guard by design —
# writes the profile with the admin SDK, which bypasses the users create rule.
# #1993 added an emailVerified gate on both halves of that path, so an
# unverified email/password signup can no longer take it. Google sign-in
# arrives verified and still works. Prefer scripts/grant-superadmin.mjs, which
# promotes an account that already exists and proves it exists first.
# ADMIN_EMAILS=
