<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Backups are off. ZedExams is a school app used by minors, and there is
         no restore story worth preserving: the only device-local state is the
         Firebase auth token and the Firestore offline cache, both of which
         rehydrate from the server on the next sign-in. Disabling Auto Backup /
         key-value backup keeps those tokens and any cached learner data from
         being copied off the device into a Google cloud backup. -->
    <application
        android:name=".ZedExamsApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- FCM push notifications. The small icon Firebase uses when it renders
             a `notification` message in the system tray while the app is
             backgrounded/killed. Points at the launcher icon so the build never
             references a missing drawable (a dedicated monochrome status icon
             can be swapped in later). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ (API 33) requires this runtime permission before any
         notification is shown. The @capacitor-firebase/messaging plugin's
         requestPermissions() prompts for it; declaring it here is what makes
         that prompt (and all FCM push delivery) possible. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Google Play Billing (subscriptions). The Play Billing Library AAR merges
         this in anyway; declared explicitly so Play Console billing detection and
         reviewers can see it in the source manifest. -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Saving a generated lesson plan / paper into the phone's public Downloads
         folder (DownloadsPlugin). CAPPED AT API 28 ON PURPOSE, and the cap is the
         whole point of the declaration: from Android 10 (API 29) an app may
         contribute to the shared Downloads collection through MediaStore with no
         permission at all, so an uncapped WRITE_EXTERNAL_STORAGE would ask
         millions of modern devices for broad storage access this app never uses
         — the kind of over-request Play flags on a Families-policy listing.
         minSdk is 24, so the 24-28 devices still in use in Zambian schools do
         need it for the legacy public-directory write. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Advertising ID: REMOVED AT MERGE TIME, deliberately.

         Play's Families policy prohibits transmitting the Android Advertising
         ID (AAID) or other persistent device identifiers from children, and
         ZedExams serves Grade 4-7 learners. We ship no ads and never read the
         AAID ourselves — but we do not have to: play-services-measurement,
         pulled in transitively by Firebase, declares AD_ID in ITS manifest,
         and the merger would add it to ours without anyone editing this file.
         A reviewer reading the MERGED manifest would then see an app for
         children requesting an advertising identifier.

         tools:node="remove" strips it from the merged result whichever
         dependency contributes it, so the guarantee survives a Firebase
         version bump. scripts/test-android-manifest.mjs fails the build if
         this declaration is deleted or an ad SDK is added. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
</manifest>
