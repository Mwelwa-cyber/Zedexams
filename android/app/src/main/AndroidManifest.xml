<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Backups are off. ZedExams is a school app used by minors, and there is
         no restore story worth preserving: the only device-local state is the
         Firebase auth token and the Firestore offline cache, both of which
         rehydrate from the server on the next sign-in. Disabling Auto Backup /
         key-value backup keeps those tokens and any cached learner data from
         being copied off the device into a Google cloud backup. -->
    <application
        android:name=".ZedExamsApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Google Play Billing (subscriptions). The Play Billing Library AAR merges
         this in anyway; declared explicitly so Play Console billing detection and
         reviewers can see it in the source manifest. -->
    <uses-permission android:name="com.android.vending.BILLING" />
</manifest>
