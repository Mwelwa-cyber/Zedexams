<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Edge-to-edge is enabled (Android 15/16): MainActivity calls
         EdgeToEdge.enable(), @capacitor-community/safe-area bridges the bar
         insets into CSS env(safe-area-inset-*), and status-bar icon style is
         driven from JS through @capacitor/core's built-in SystemBars plugin.
         Deliberately NO statusBarColor / navigationBarColor /
         windowOptOutEdgeToEdgeEnforcement attributes here — they are the
         deprecated Android 15 edge-to-edge parameters Play Console flags. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Paint the window splash-navy (not the default white) so the frame
             shown between the splash dismissing and the WebView's first paint
             matches the animated in-page splash instead of flashing white. -->
        <item name="android:windowBackground">@color/zed_splash_bg</item>
    </style>


    <!-- Launch theme. MainActivity calls SplashScreen.installSplashScreen(),
         so this uses the AndroidX SplashScreen API attributes
         (windowSplashScreenBackground / windowSplashScreenAnimatedIcon).
         The old android:background=@drawable/splash is ignored on Android 12+
         (it fell back to a WHITE splash) — the launch white-screen bug.
         MainActivity also sets setKeepOnScreenCondition() to hold this branded
         splash until the WebView paints index.html, so the WebView cold-start
         window doesn't surface as blank cream (@color/zed_splash_bg). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/zed_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!-- Hand off to the regular activity theme once the splash dismisses. -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>