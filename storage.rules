rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthed() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    // Email-verification gate, mirroring firestore.rules: the Auth token's
    // email_verified claim is the source of truth, with a server-granted
    // grace window (users.verificationGraceUntil, written only by the
    // migration/admin SDK) honoured for accounts that predate enforcement.
    // The grace lookup only evaluates when the claim is false, so verified
    // users never pay the extra firestore.get. There are no signup-time
    // Storage writes, so unlike Firestore there is no bare-isAuthed()
    // carve-out — every path requires isVerified().
    function tokenEmailVerified() {
      return 'email_verified' in request.auth.token
        && request.auth.token.email_verified == true;
    }
    // THE SHAPE OF THIS FUNCTION IS LOAD-BEARING, and pinned as text by
    // scripts/test-storage-rules-text.mjs. Every path in this file runs through
    // it, so a term added here executes on 100% of Storage rule evaluations.
    //
    // #2258 added one: a `notBeingDeleted()` deletion gate that asked Firestore,
    // from the Storage rules engine, whether an accountPurgeJobs tombstone
    // existed. That is a CROSS-SERVICE read, a different and more fragile
    // mechanism than the in-service `exists()` firestore.rules uses for the same
    // question, and it fails closed. It stopped resolving; every arm collapsed;
    // production recorded zero rule allows from 10 Aug 2026 — including on paths
    // requiring no role at all (picture-bank, quiz-images, lesson-images,
    // lesson-files) — and uploads were down across the product for five days.
    // #2399 took it off isVerified(); this removed the function outright.
    //
    // Note what the `||` buys and why it must not become an `&&` chain:
    // `inVerificationGrace()` DOES make a cross-service read, but only when the
    // token claim is false, so a verified user never reaches it. That
    // short-circuit is the reason this predicate is normally free.
    //
    // The deletion gate is NOT coming back here. It was the wrong tool twice
    // over — besides the cross-service read, a rules predicate can only refuse a
    // NEW write, so it never addressed the objects already written between the
    // purge enumerating the bucket and the gate taking effect. Its replacement
    // is cleanup off the request path: functions/account/accountPurgeResweeper.js
    // re-enumerates a deleted uid's Storage prefixes once the 60-minute ID-token
    // window has closed and deletes whatever landed in it.
    function isVerified() {
      return isAuthed()
        && (tokenEmailVerified() || inVerificationGrace());
    }
    function inVerificationGrace() {
      return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && 'verificationGraceUntil' in userDoc().data
        && userDoc().data.verificationGraceUntil > request.time;
    }

    // ── platform-admin claim (mirrors firestore.rules' isPlatformAdmin) ──
    // Minted only by the adminSetPlatformAdmin Cloud Function (admin SDK), so
    // it is tamper-proof, and checked WITHOUT a Firestore read — which is what
    // makes it a break-glass path for an admin whose user doc is missing or
    // unreadable. "Claim present AND true" so a token without it denies closed.
    function isPlatformAdmin() {
      return isAuthed()
        && 'platformAdmin' in request.auth.token
        && request.auth.token.platformAdmin == true;
    }

    // The boolean superAdmin claim minted by adminSetUserRole /
    // scripts/grant-superadmin.mjs. firestore.rules honours it for its most
    // sensitive reads (isSuperAdmin), so it is at least as trusted as the
    // Firestore role string it is minted alongside.
    function hasSuperAdminClaim() {
      return isAuthed()
        && 'superAdmin' in request.auth.token
        && request.auth.token.superAdmin == true;
    }

    // The `role` custom claim minted by buildRoleClaims()
    // (functions/security/adminClaims.js) — the SAME admin-SDK write that sets
    // users/{uid}.role, so the claim and the document agree by construction.
    // Trusting it is trusting the authority that wrote the document, not a
    // second weaker signal: custom claims are settable only by the Admin SDK,
    // which is exactly why isPlatformAdmin()/hasSuperAdminClaim() above are
    // already trusted here and in firestore.rules.
    //
    // WHY IT IS CHECKED BEFORE THE FIRESTORE ARM (#2394 follow-up). Every role
    // decision in this file otherwise costs a CROSS-SERVICE lookup —
    // firestore.exists() + firestore.get() reaching from the Storage rules
    // engine into Firestore. That is a different, more fragile mechanism than
    // the in-service get() firestore.rules uses for the identical decision, and
    // it fails CLOSED: when it does not resolve, `firestore.exists(users/…)`
    // is false, both role arms collapse, and EVERY teacher/admin upload in the
    // product is refused as `storage/unauthorized` — past papers, quiz images,
    // lesson files, branding — while Firestore itself keeps working, because
    // firestore.rules never leaves its own service.
    //
    // So the claim is the fast path and the Firestore read is the FALLBACK,
    // kept so an account whose claims are stale or were never minted keeps
    // working exactly as before. Nothing that was allowed becomes denied.
    //
    // "Claim present AND equals" mirrors tokenEmailVerified(), so a token
    // without the claim denies closed rather than erroring.
    function hasRoleClaim(role) {
      return isAuthed()
        && 'role' in request.auth.token
        && request.auth.token.role == role;
    }

    // ── role helpers — MUST stay in step with firestore.rules ────────────
    // firestore.rules: "Admin and superAdmin are equivalent — both get full
    // read/write access", and its isTeacherOrAbove() accepts
    // teacher/admin/superAdmin. These two used to accept the literal string
    // 'admin' (and 'teacher') only, so an account promoted by
    // scripts/grant-superadmin.mjs — which writes role 'superAdmin' BY
    // DEFAULT — passed every Firestore check and was refused by every Storage
    // write behind them.
    //
    // That asymmetry is invisible from the UI and reads as a broken feature:
    // the admin opens the Past Paper Studio, the draft pastPapers doc is
    // created (Firestore says admin), and then the file upload dies with
    // "User does not have permission to access 'papers/<uid>/<paperId>/…'".
    // Same for syllabus uploads, picture-bank images and every other
    // admin-authored asset. Pinned by the superAdmin section of
    // scripts/test-storage-rules-emulator.mjs.
    //
    // Identity parity only: what a caller IS changes here, what they may
    // UPLOAD does not — every write still goes through its
    // valid*Upload() content-type and size check.
    // isVerified() still gates EVERY arm, including the claim ones — unlike
    // Firestore there are no signup-time Storage writes, so nothing here has a
    // reason to run before the caller's email is verified.
    function isAdmin() {
      return isVerified()
        && (
          isPlatformAdmin()
          || hasSuperAdminClaim()
          || hasRoleClaim('admin')
          || hasRoleClaim('superAdmin')
          || (
            firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
            && (userDoc().data.role == 'admin' || userDoc().data.role == 'superAdmin')
          )
        );
    }

    function isTeacherOrAdmin() {
      return isVerified()
        && (
          isPlatformAdmin()
          || hasSuperAdminClaim()
          || hasRoleClaim('teacher')
          || hasRoleClaim('admin')
          || hasRoleClaim('superAdmin')
          || (
            firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
            && (
              userDoc().data.role == 'teacher'
              || userDoc().data.role == 'admin'
              || userDoc().data.role == 'superAdmin'
            )
          )
        );
    }

    // ── account-status gate (P0: suspended-account enforcement) ──
    // Canonical users/{uid}.status ('active'|'suspended'|'deleted'), written
    // only by the admin adminSetUserStatus Cloud Function. Absence == active.
    // Folded into ownsPath() below (blocks suspended uploads + own-file reads)
    // and into the premium papers read. Deliberately kept OUT of the broad
    // isVerified() used by every asset read so ordinary image loads don't each
    // pay a firestore.get.
    function callerActive() {
      return !firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        || !('status' in userDoc().data)
        || (userDoc().data.status != 'suspended' && userDoc().data.status != 'deleted');
    }

    // ── premium learner-content entitlement (P0) ─────────────────
    // Mirrors hasPremiumAccess() in src/utils/subscriptionConfig.js.
    //
    // 2026-08-28: past-paper PDFs/scans are no longer gated by this at all —
    // reading the paper itself is free for any verified, active learner (see
    // the papers read rules below). What this still guards is the MARK SCHEME
    // / answer key on a single-file paper (isMarkSchemeFile()), which stays a
    // paid learner artefact. Admins/superAdmins always pass; teacher/admin
    // content managers pass via the papers read rule's isTeacherOrAdmin() arm.
    function hasValidEntitlement() {
      return isVerified()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && (
          ('role' in userDoc().data
            && (userDoc().data.role == 'admin' || userDoc().data.role == 'superAdmin'))
          || (
            (
              ('premium' in userDoc().data && userDoc().data.premium == true)
              || ('isPremium' in userDoc().data && userDoc().data.isPremium == true)
              || ('paymentStatus' in userDoc().data && userDoc().data.paymentStatus == 'active')
              || ('subscriptionStatus' in userDoc().data && userDoc().data.subscriptionStatus == 'active')
              || ('plan' in userDoc().data && userDoc().data.plan == 'premium')
            )
            && (
              ('subscriptionLifetime' in userDoc().data && userDoc().data.subscriptionLifetime == true)
              || ('subscriptionExpiry' in userDoc().data
                  && userDoc().data.subscriptionExpiry > request.time)
            )
          )
        );
    }

    function ownsPath(ownerUid) {
      return isVerified() && request.auth.uid == ownerUid && callerActive();
    }

    // ── question paper vs mark scheme, from the STORAGE PATH alone ──
    // (2026-08-28, unpaid-learners-past-papers). Reading a past paper's
    // question paper is now free for everybody signed in and in good
    // standing; only the mark scheme / answer key still needs
    // hasValidEntitlement(). Storage rules cannot ask "is this file's role
    // mark-scheme" without a firestore.get() on the paper doc on every single
    // read of every page — and CLAUDE.md's own incident history (#2258: a
    // cross-service read wired into a shared predicate took Storage down for
    // five days, invisible to the emulator) is exactly why that is not worth
    // it here. So this is a path-only check instead:
    //
    //   - a single-file upload (uploadPaperPdf, src/utils/pastPapers.js)
    //     is named `{paperId}/{kind}-{filename}` with kind 'paper' or
    //     'mark-scheme' — the terminal segment says which it is.
    //   - a SCANNED paper's pages (uploadPaperAsset) are named
    //     `{paperId}/assets/{idx}-{filename}` with no kind in the path at
    //     all, so a mark-scheme scan is indistinguishable here from a
    //     question-paper scan. Rather than lock a scanned paper's questions
    //     behind a guess, every page under `assets/` reads as free — that
    //     also frees a scanned paper's mark-scheme pages, deliberately,
    //     until a migration gives mark-scheme scans their own path.
    //
    // Reads `resource.name` (the object's full bucket path) rather than the
    // `{fileName=**}` match-path capture: that capture's type has no
    // `matches()` — calling it errors the whole read closed, PDF question
    // papers included, which is exactly the fail-closed shape that makes a
    // rules regression like this easy to miss without a real emulator run.
    function isMarkSchemeFile() {
      return !resource.name.matches('.*/assets/.*')
        && resource.name.matches('.*mark-scheme-[^/]*$');
    }

    function validPaperUpload() {
      // Past papers accept a single PDF, a Word document, or a series
      // of scanned images. Scanned ECZ papers from the older archive
      // arrived as JPGs (one per page); modern teacher-typed papers
      // often start life as .docx. 50MB per file is the cap — the
      // admin Studio enforces it client-side too, this is the server
      // backstop.
      //
      // `<=`, not `<`: src/utils/pastPapers.js rejects a file only when it is
      // LARGER than MAX_PAPER_FILE_BYTES, so a file of exactly 50 MB passed
      // the Studio's check and was refused here — as an opaque
      // storage/unauthorized, indistinguishable from a permissions problem.
      // The two boundaries have to name the same file.
      return request.resource.size <= 50 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          || request.resource.contentType == 'image/jpeg'
          || request.resource.contentType == 'image/png'
          || request.resource.contentType == 'image/webp'
        );
    }

    function validQuizImageUpload() {
      // 10 MB backstop (was 5 MB). Every quiz-image upload path compresses to a
      // 1200px-wide JPEG first (compressImage / compressImportedImage → ~1-2 MB),
      // so this is never hit in normal use — but a very detailed, very tall scan
      // (kept at 1200px wide) can re-encode past 5 MB and used to be rejected
      // here with an opaque "storage/unauthorized" instead of uploading. Matches
      // the validVisualStudioUpload headroom for the same "detailed diagram"
      // reason. The client still pre-checks the ORIGINAL file at 15 MB (canvas
      // memory guard); this bounds the COMPRESSED artifact that actually lands.
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function validLessonImageUpload() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    // Visual Studio baked diagrams (image + labels flattened to PNG) and
    // uploaded source pictures. Slightly larger cap than quiz images because a
    // detailed labelled diagram baked at 2× can run past the 5 MB line.
    function validVisualStudioUpload() {
      return request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function validLessonPresentationUpload() {
      // SVG is intentionally excluded — pptxPresentationRenderer.js used to
      // upload programmatically-built SVG slides, but a malicious .pptx could
      // inject script-bearing attributes that would execute on direct-URL
      // navigation against firebasestorage.googleapis.com. The renderer now
      // rasterizes to PNG via canvas before upload.
      return request.resource.size <= 50 * 1024 * 1024
        && (
          request.resource.contentType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation'
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('image/(jpeg|png|webp)')
        );
    }

    function validLessonFileUpload() {
      return request.resource.size <= 25 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        );
    }

    // Past papers: learners can read, teachers/admins can only write under
    // their own user folder. One-level legacy writes are admin-only.
    match /papers/{ownerUid}/{fileName=**} {
      // 2026-08-28: the question paper is free for any verified, active
      // learner. Only the mark scheme (isMarkSchemeFile()) still needs
      // hasValidEntitlement() — see that function's comment above.
      allow read: if isVerified()
        && callerActive()
        && (
          !isMarkSchemeFile()
          || hasValidEntitlement()
          || isTeacherOrAdmin()
          || ownsPath(ownerUid)
        );
      allow create, update: if ownsPath(ownerUid)
        && isTeacherOrAdmin()
        && validPaperUpload();
      allow delete: if ownsPath(ownerUid) && isTeacherOrAdmin();
    }

    match /papers/{fileName} {
      allow read: if isVerified()
        && callerActive()
        && (
          !isMarkSchemeFile()
          || hasValidEntitlement()
          || isTeacherOrAdmin()
        );
      allow create, update: if isAdmin() && validPaperUpload();
      allow delete: if isAdmin();
    }

    // Quiz question images: teachers/admins can upload only to their own folder.
    match /quiz-images/{ownerUid}/{fileName=**} {
      allow read: if isVerified();
      allow create, update: if ownsPath(ownerUid)
        && isTeacherOrAdmin()
        && validQuizImageUpload();
      allow delete: if ownsPath(ownerUid) && isTeacherOrAdmin();
    }

    // Teacher-private assessment question images. Only the owning teacher
    // and admins can read these (assessments are not learner-facing).
    match /assessment-images/{ownerUid}/{fileName=**} {
      allow read: if ownsPath(ownerUid) || isAdmin();
      allow create, update: if ownsPath(ownerUid)
        && isTeacherOrAdmin()
        && validQuizImageUpload();
      allow delete: if ownsPath(ownerUid) && isTeacherOrAdmin();
    }

    // Versioned, cached assessment EXPORTS (paper.docx / paper.pdf / scheme.docx)
    // keyed by source hash. Written ONLY by Cloud Functions (admin SDK bypasses
    // rules); no client may write. Direct client reads are also denied — bytes
    // are served exclusively through the branded /downloads/... endpoint, which
    // enforces ownership server-side and never leaks a Storage token. Keeping
    // read closed here means even a leaked object path is useless to a client.
    match /assessment-exports/{ownerUid}/{filePath=**} {
      allow read: if false;
      allow write: if false;
    }

    // Visual Studio: a teacher's baked diagrams + uploaded source pictures.
    // Owner-scoped folder; any signed-in user can READ (a diagram sent into a
    // shared assessment/worksheet must remain loadable), only the owner/admin
    // writes. Bucket CORS (cors.json) must be deployed so exporters can read
    // the BYTES — see CLAUDE.md "npm run storage:cors".
    match /visual-studio/{ownerUid}/{fileName=**} {
      allow read: if isVerified();
      allow create, update: if ownsPath(ownerUid)
        && isTeacherOrAdmin()
        && validVisualStudioUpload();
      allow delete: if ownsPath(ownerUid) && isTeacherOrAdmin();
    }

    // Imported lesson images: teachers/admins upload into their own folder.
    // Learners can read them as part of playable lessons.
    match /lesson-images/{ownerUid}/{assetBatchId}/{fileName=**} {
      allow read: if isVerified();
      allow create, update: if ownsPath(ownerUid)
        && isTeacherOrAdmin()
        && validLessonImageUpload();
      allow delete: if ownsPath(ownerUid) && isTeacherOrAdmin();
    }

    // Preserved PowerPoint lessons: original PPTX plus generated web slides.
    match /lesson-presentations/{ownerUid}/{assetBatchId}/{fileName=**} {
      allow read: if isVerified();
      allow create, update: if ownsPath(ownerUid)
        && isTeacherOrAdmin()
        && validLessonPresentationUpload();
      allow delete: if ownsPath(ownerUid) && isTeacherOrAdmin();
    }

    // Syllabus-replacement Phase A: admin uploads new .xlsx syllabi here
    // and the parseSyllabusUpload Cloud Function (Storage onFinalize)
    // extracts them into cbcKnowledgeBase/{version}/draftTopics. Reads
    // are admin-only too — drafts may include unpublished curriculum.
    function validSyllabusXlsxUpload() {
      return request.resource.size < 25 * 1024 * 1024
        && (
          request.resource.contentType ==
            'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
          || request.resource.contentType == 'application/octet-stream'
        );
    }
    match /syllabus-uploads/{version}/{fileName=**} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validSyllabusXlsxUpload();
      allow delete: if isAdmin();
    }

    // PDF syllabi uploaded by admins for the extractTopicsFromPdf callable
    // (functions/teacherTools/extractTopicsFromPdf.js). PDF-only; the
    // callable rejects any path that doesn't end in .pdf, but the rule
    // pins it on the storage side too so non-PDF uploads can't squat the
    // path and bypass the callable's quota meter.
    function validSyllabusPdfUpload() {
      return request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }
    match /syllabus-uploads-pdf/{version}/{fileName=**} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validSyllabusPdfUpload();
      allow delete: if isAdmin();
    }

    // Admin curriculum module uploads — DOCX / PDF / XLSX. Consumed by
    // the uploadCurriculumModule callable
    // (functions/teacherTools/uploadCurriculumModule.js) which downloads
    // the file, parses it, and writes into curriculum/ + rag_chunks/.
    // Path is keyed by uploader uid so different admins don't collide,
    // and so a tampered client can't squat someone else's path.
    function validCurriculumModuleUpload() {
      return request.resource.size < 25 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf'
          || request.resource.contentType ==
            'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          || request.resource.contentType ==
            'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
          || request.resource.contentType == 'application/octet-stream'
        );
    }
    match /curriculum-uploads/{ownerUid}/{fileName=**} {
      allow read: if isAdmin();
      allow create, update: if ownsPath(ownerUid) && isAdmin()
        && validCurriculumModuleUpload();
      allow delete: if isAdmin();
    }

    // Sample Zambian assessment papers (PDF/DOCX) the admin uploads so
    // extractAssessmentFormat can distil a format-profile draft. Path is
    // keyed by uploader uid like curriculum-uploads above; the Cloud
    // Function only accepts paths under this prefix.
    function validAssessmentFormatSampleUpload() {
      return request.resource.size < 25 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf'
          || request.resource.contentType ==
            'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          || request.resource.contentType == 'application/octet-stream'
          // Photos of papers (Exam Paper Library) — phone snaps of single-page
          // lower-grade papers. Compressed client-side before upload.
          || request.resource.contentType == 'image/jpeg'
          || request.resource.contentType == 'image/png'
          || request.resource.contentType == 'image/webp'
        );
    }
    match /assessment-format-samples/{ownerUid}/{fileName=**} {
      allow read: if isAdmin();
      allow create, update: if ownsPath(ownerUid) && isAdmin()
        && validAssessmentFormatSampleUpload();
      allow delete: if isAdmin();
    }

    // Picture bank blobs — teaching figures teachers browse and attach to
    // assessments. Teacher-read (the picker resolves download URLs from
    // storagePath); writes come from admins (uploads) and the extraction
    // Cloud Function (admin SDK bypasses rules).
    //
    // Raster-only (jpeg/png/webp) — SVG is DELIBERATELY excluded for the same
    // reason validQuizImageUpload / validLessonPresentationUpload exclude it:
    // an SVG can carry <script>/on* handlers that execute when the blob is
    // opened directly on the firebasestorage.googleapis.com origin, and every
    // picture-bank blob is readable by any verified user (allow read below) and
    // its download URL is stored in a Firestore doc. The broad `image/.*`
    // matcher this replaces silently re-opened that hole. gpt-image-1 and the
    // extraction pipeline both emit PNG, so no legitimate writer needs SVG.
    function validPictureBankUpload() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /picture-bank/{allPaths=**} {
      allow read: if isVerified();
      allow create, update: if isAdmin() && validPictureBankUpload();
      allow delete: if isAdmin();
    }

    // Notes Studio inline images: PNG/JPEG/WebP/GIF up to 5 MB, written by
    // the rich-text editor. Must come BEFORE the whole-note files match
    // since {fileName=**} would otherwise swallow the /inline/ segment.
    match /lesson-files/{ownerUid}/{assetBatchId}/inline/{fileName=**} {
      allow read: if isVerified();
      allow create, update: if ownsPath(ownerUid)
        && isTeacherOrAdmin()
        && validLessonImageUpload();
      allow delete: if ownsPath(ownerUid) && isTeacherOrAdmin();
    }

    // Notes Studio whole-note files: PDF or Word (DOC/DOCX), 25 MB max.
    // Mirrors lesson-images / lesson-presentations: keyed by assetBatchId
    // because lessons may not have a Firestore doc id at upload time.
    match /lesson-files/{ownerUid}/{assetBatchId}/{fileName=**} {
      allow read: if isVerified();
      allow create, update: if ownsPath(ownerUid)
        && isTeacherOrAdmin()
        && validLessonFileUpload();
      allow delete: if ownsPath(ownerUid) && isTeacherOrAdmin();
    }

    // Audit D3 — MoMo invoice PDFs. Writes are admin-only (the
    // invoiceGenerator Cloud Function uses the admin SDK so this
    // doesn't block legitimate generation). Reads are owner +
    // admin; the path's own segment carries the userId so a
    // tampered client can't enumerate someone else's receipts.
    match /invoices/{userId}/{fileName} {
      allow read: if isVerified() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    // Short-lived export staging. Studios upload a just-generated file here
    // ONLY so its real filename can be carried on the download via the object's
    // Content-Disposition metadata — browsers like DuckDuckGo ignore the
    // <a download> name for blob: URLs and would otherwise save "<uuid>.docx".
    // Owner-scoped; the tokened download URL fetches it, and tmpDownloadReaper
    // sweeps anything older than an hour. 25 MB cap covers any studio export.
    function validTmpDownload() {
      return request.resource.size < 25 * 1024 * 1024;
    }
    match /tmp-downloads/{ownerUid}/{fileName=**} {
      allow read: if ownsPath(ownerUid);
      allow create: if ownsPath(ownerUid) && validTmpDownload();
      allow delete: if ownsPath(ownerUid);
    }

    // Teacher Settings branding assets: profile photo, school logo, teacher
    // signature, letterhead. Fixed filenames per asset
    // (overwrite-in-place, so no orphan buildup). Owner-only read — branding
    // is baked into exports in the OWNER'S browser; nothing learner-facing
    // references these URLs. Bucket CORS (cors.json) must be deployed so the
    // PDF/DOCX exporters can read the BYTES — see CLAUDE.md "npm run
    // storage:cors".
    function validBrandingUpload() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    // Single path segment (NOT a recursive wildcard): the client writes flat
    // versioned filenames (profile-photo-<ts>.jpg, school-logo-<ts>.png, …),
    // so nested paths under a uid have no legitimate writer.
    match /user-branding/{ownerUid}/{fileName} {
      allow read: if ownsPath(ownerUid) || isAdmin();
      allow create, update: if ownsPath(ownerUid)
        && isTeacherOrAdmin()
        && validBrandingUpload();
      allow delete: if ownsPath(ownerUid) && isTeacherOrAdmin();
    }

    // Block all other paths
    // ── spelling-audio: pre-generated pronunciation ──────────────────
    //
    // PUBLIC READ, and that leaks nothing new: /games is a signed-out route,
    // so the learner playing a word may have no account — and the words
    // themselves already ship in every client bundle
    // (src/data/spellingBank.js, 879 of them). The audio is a second copy of
    // something already public.
    //
    // SERVER-ONLY WRITE. The objects are written by generateSpellingAudio
    // with the admin SDK, which bypasses rules entirely, so there is no
    // client write to allow — and denying it outright means a compromised
    // admin session still cannot replace what a child hears.
    match /spelling-audio/{gradeFolder}/{fileName} {
      allow read:  if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
