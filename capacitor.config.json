{
  "appId": "com.zedexams.android",
  "appName": "ZedExams",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK"
    },
    "EdgeToEdge": {
      "backgroundColor": "#4C1D95"
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["google.com"]
    },
    "Keyboard": {
      "resize": "native"
    }
  }
}
