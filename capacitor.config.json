{
  "appId": "com.zedexams.android",
  "appName": "ZedExams",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SafeArea": {},
    "SystemBars": {
      "insetsHandling": "disable"
    },
    "EdgeToEdge": {
      "statusBarColor": "#00000000",
      "navigationBarColor": "#00000000"
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["google.com"]
    },
    "Keyboard": {
      "resize": "native"
    }
  }
}
