{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "syllabi/*.pdf"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(), payment=(), usb=(), magnetometer=(), accelerometer=(), gyroscope=(), browsing-topics=()" },
          { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' blob: https://www.google.com https://www.gstatic.com https://apis.google.com https://eu.i.posthog.com https://*.posthog.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; worker-src 'self' blob:; manifest-src 'self'; connect-src 'self' https://*.googleapis.com https://*.google.com https://*.gstatic.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firebasestorage.app https://*.cloudfunctions.net https://*.run.app https://eu.i.posthog.com https://*.posthog.com https://api.lenco.co https://*.sentry.io https://*.ingest.sentry.io; frame-src 'self' https://www.google.com https://recaptcha.google.com https://*.firebaseapp.com https://view.officeapps.live.com https://*.lenco.co https://play.google.com; form-action 'self' https://*.lenco.co" }
        ]
      },
      {
        "source": "/",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/sw-reload-clients.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/boot.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|gif|webp|avif|svg|ico)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.@(woff|woff2|ttf|otf|eot)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.@(mp3|wav|ogg)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/studio/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/syllabi/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" },
          { "key": "Content-Disposition", "value": "inline" }
        ]
      },
      {
        "source": "/timetables/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" },
          { "key": "Content-Disposition", "value": "inline" }
        ]
      }
    ],
    "redirects": [
      { "source": "/welcome", "destination": "/", "type": 301 },
      { "source": "/plans", "destination": "/pricing", "type": 301 },
      { "source": "/teachers/**", "destination": "/teachers", "type": 301 }
    ],
    "rewrites": [
      {
        "source": "/downloads/**",
        "function": {
          "functionId": "apiAssessmentDownload",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/teacher/lesson-plan/stream",
        "function": {
          "functionId": "apiGenerateLessonPlan",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/teacher/worksheet/stream",
        "function": {
          "functionId": "apiGenerateWorksheet",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/tts",
        "function": {
          "functionId": "apiTextToSpeech",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/payments/lenco/webhook",
        "function": {
          "functionId": "lencoWebhook",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/whatsapp/webhook",
        "function": {
          "functionId": "apiWhatsAppWebhook",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/teacher/download",
        "function": {
          "functionId": "apiLibraryDownload",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/track/visit",
        "function": {
          "functionId": "apiTrackVisit",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/account/delete-request",
        "function": {
          "functionId": "apiRequestAccountDeletion",
          "region": "us-central1"
        }
      },
      {
        "source": "/consent",
        "function": {
          "functionId": "apiGuardianConsent",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/image-proxy",
        "function": {
          "functionId": "apiImageProxy",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/app.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "singleProjectMode": false
  }
}
